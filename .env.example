# eAblage Docker-Konfiguration
# Diese Datei nach .env kopieren und die Werte an die jeweilige Instanz anpassen.

# Deployment-Ziel: prod fuer Produktion, test fuer getrennte Testinstanzen.
# Kennzeichnung fuer deploy-prod.ps1 / deploy-test.ps1; trennt keine Ressourcen.
EABLAGE_INSTANCE=prod

# Webzugriff
EABLAGE_WEB_PORT=8082

# Host-Pfade
# Die lokale PHP-Konfiguration wird nicht in das Image eingebaut,
# sondern als einzelne Datei read-only in den Webcontainer gemountet.
EABLAGE_CONFIG_PATH=/volume1/docker/eablage/web/konfiguration.php

# Gemeinsames Datenverzeichnis für inbox, archiv und meta.
# Im Container ist dieses Verzeichnis immer unter /data erreichbar.
EABLAGE_DATA_PATH=/volume1/eablage-data

# MariaDB
EABLAGE_DB_HOST=mariadb
EABLAGE_DB_NAME=eablage
EABLAGE_DB_USER=eablage
EABLAGE_DB_PASSWORD=PASSWORT_HIER_EINTRAGEN

# Internes Python-Backend
EABLAGE_BACKEND_URL=http://backend:8000


# Backend: Metadaten gezielt beschreibbar; übrige Daten nur lesbar.
# Testinstanz: /volume1/eablage-test-data/meta verwenden!
# Containerpfad muss pfadMetadaten_linux in der Datenbank entsprechen.
EABLAGE_META_PATH=/volume1/eablage-data/meta
EABLAGE_META_CONTAINER_PATH=/data/meta
# Standard entspricht Apache www-data. Bei abweichenden NAS-Rechten anpassen.
EABLAGE_BACKEND_UID=33
EABLAGE_BACKEND_GID=33


# Lokale OCR im Backend und Worker, ohne Veränderung der Original-PDF.
EABLAGE_OCR_ENABLED=true
EABLAGE_OCR_LANGUAGES=deu+eng

# Inbox im Hintergrund vorbereiten. Manuelles Klassifizieren bleibt verfügbar.
EABLAGE_INBOX_ENABLED=true
EABLAGE_INBOX_INTERVAL=60
