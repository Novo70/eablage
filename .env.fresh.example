# Nur für compose.fresh.yaml. Die laufende Installation nutzt weiterhin .env.
# Eigener, freier Port und ein neuer, leerer Datenordner auf dem NAS.
EABLAGE_WEB_PORT=8084
EABLAGE_DATA_PATH=/volume1/eablage-fresh-data

# Verschiedene starke Passwörter wählen. Für die erste Einrichtung keine
# Dollarzeichen, Rautezeichen, Leerzeichen oder Anführungszeichen verwenden.
EABLAGE_DB_PASSWORD=HIER_EIN_STARKES_ANWENDUNGSPASSWORT
MARIADB_ROOT_PASSWORD=HIER_EIN_ANDERES_STARKES_ROOT_PASSWORT


# Lokale OCR im Backend und Worker, ohne Veränderung der Original-PDF.
EABLAGE_OCR_ENABLED=true
EABLAGE_OCR_LANGUAGES=deu+eng

# Inbox im Hintergrund vorbereiten. Manuelles Klassifizieren bleibt verfügbar.
EABLAGE_INBOX_ENABLED=true
EABLAGE_INBOX_INTERVAL=60
